/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    private int count =  0 ;
    public int pathSum(TreeNode root, int targetSum) {
        if(root == null) return 0;

        countPath(root , targetSum);

        pathSum(root.left  , targetSum);
        pathSum(root.right , targetSum);
        return count ;
    }
    // node.left => node.left.val ---> += targetSum ===> count++;
    // node.right => node.right.val  ---> += targetSum ===> count++;

    public void countPath(TreeNode root , long remainSum){
        if(root == null) return ;
        if(root.val == remainSum){
            count++;
        }
        remainSum = remainSum - root.val ; 
        countPath(root.left , remainSum);
        countPath(root.right , remainSum);
    }
}
