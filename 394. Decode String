class Solution {
    public String decodeString(String s) {
        Stack<Integer> st = new Stack<>();
        Stack<StringBuilder> str1 = new Stack<>();
        StringBuilder sb = new StringBuilder();
        int n = 0 ;

        for(char ch : s.toCharArray()){
            if(Character.isDigit(ch)){
            n = n * 10 + ( ch - '0');
            }
            else if(ch == '['){
                 st.push(n);
                n = 0;
                str1.push(sb);
                sb = new StringBuilder();
            }else if (ch == ']') {
                int k = st.pop();
                StringBuilder temp = sb;
                sb = str1.pop();
                while (k-- > 0) {
                    sb.append(temp);
                }
            }
            else {
                sb.append(ch);
            }
        }
        return sb.toString();
    }
}
